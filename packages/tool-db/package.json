{
  "name": "tool-db",
  "version": "3.0.0",
  "description": "A database on top of Nostr: signed data, CRDTs and relays, for Node and browsers.",
  "author": "Manwe <manuel.etchegaray7@gmail.com>",
  "homepage": "https://github.com/Manwe-777/tool-db#readme",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manwe-777/tool-db.git"
  },
  "scripts": {
    "bundle": "browserify ./dist/index.js --standalone tooldb | uglifyjs -cm > ./bundle.js",
    "build": "tsc && npm run bundle",
    "tsc": "tsc",
    "prepublish": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/Manwe-777/tool-db/issues"
  },
  "devDependencies": {
    "browserify": "^17.0.0",
    "typescript": "^4.7.4",
    "uglify-js": "^3.16.2"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.4",
    "events": "^3.3.0"
  }
}
